  "main": "index.js",
  "bin": {
    "deepseek": "scripts/deepseek-cli.js"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs = require('fs'); if (fs.existsSync('config')) fs.cpSync('config', 'dist/config', { recursive: true });\"",
    "start": "node dist/index.js",
    "dev": "nodemon --ext js,ts,json --ignore dist/ --ignore public/ --exec tsx index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "deepseek": "node scripts/deepseek-cli.js",
    "db:reset-orders": "node src/utils/resetOrders.js",
    "db:migrate-categories": "node src/utils/migrateCategories.js"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "agenda": "^5.0.0",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "blendy": "^0.0.1",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.1",
    "multer": "^2.1.1",
    "opossum": "^10.0.0",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
