# ==============================================================================
# VENTIMAX (PLANTILLA MULTIMARCA) - REPOSITORY GITIGNORE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencias de Paquetes
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
web_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml

# ------------------------------------------------------------------------------
# 2. Secretos, Credenciales y Variables de Entorno
# ------------------------------------------------------------------------------
# Bloquear todos los archivos de entorno
.env
.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
*.env

# Preservar explícitamente plantillas de entorno
!.env.example
!.env.template

# Llaves privadas, certificados y credenciales de servicios
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
credentials.json
client_secret*.json
service-account*.json
firebase-adminsdk*.json

# ------------------------------------------------------------------------------
# 3. Bases de Datos Locales, Dumps, Mocks y Backups
# ------------------------------------------------------------------------------
# Base de datos JSON temporal de tests/mocks locales (services/dbLocal.js)
temp_db.json
temp_db*.json

# Datos personales de clientes (exportaciones de pedidos, direcciones, teléfonos): nunca al repo
todas_las_direcciones*.json
direcciones_clientes*.json
addresses*.json
table.md
table-no-phone.md
*clientes*.csv
*clientes*.xlsx
exports/

# SQLite, Redis y bases de datos embebidas
*.sqlite
*.sqlite3
*.db
*.db3
dump.rdb
*.dump
*.sql
*.sql.gz

# Directorios y archivos de copias de seguridad
backups/
*.bak
*.backup
*.old

# ------------------------------------------------------------------------------
# 4. Logs y Archivos de Diagnóstico en Ejecución
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnósticos y reportes de crash de Node.js
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Procesos, PIDs y candados
pids/
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# 5. Cobertura de Pruebas y Reportes de Calidad
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
reports/
*.lcov

# ------------------------------------------------------------------------------
