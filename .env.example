WHATSAPP_TOKEN=
VERIFY_TOKEN=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GLADIA_API_KEY=
DEEPGRAM_API_KEY=
MONGODB_URI=mongodb+srv://cariberox4_db_user:HbWtVLY1s8H00Cbn@ventimax.zqa1nc0.mongodb.net/
# Primer administrador: solo se usa si la base NO tiene ningún usuario (arranque en una base nueva).
# ADMIN_PASS de al menos 12 caracteres. Después se gestionan los usuarios desde el panel.
ADMIN_USER=
ADMIN_PASS=
# Sin uso actual en el código (reservada).
SESSION_SECRET=
# Firma de las sesiones del panel. Obligatoria: con NODE_ENV=production el servidor no arranca si falta
# o tiene menos de 32 caracteres. Generar con: openssl rand -hex 32
JWT_SECRET=
DELIVERY_PHONE_NUMBER=
ADMIN_PHONE_NUMBER_2=
ADMIN_PHONE_NUMBER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_ORDER=
IG_VERIFY_TOKEN=
IG_ACCOUNT_ID=
IG_ACCESS_TOKEN=
IG_APP_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
META_PIXEL_ID=
META_CAPI_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
FB_VERIFY_TOKEN=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Puerto HTTP del servidor (lo lee index.ts; Render lo asigna automáticamente)
PORT=3000

# Alias legacy de WHATSAPP_PHONE_NUMBER_ID (se usa solo si el primero está vacío)
PHONE_NUMBER_ID=

# Alias legacy de ADMIN_PHONE_NUMBER (configStore lo resuelve a ese valor)
WHATSAPP_PHONE=

# Nombre de la plantilla de Meta para reactivar carritos abandonados
WHATSAPP_TEMPLATE_REACTIVACION=

# Milisegundos de espera antes de procesar ráfagas de webhooks (por defecto 1200; en test es 0)
WEBHOOK_DEBOUNCE_MS=1200

# Código de prueba de Meta CAPI para verificar eventos en Events Manager (dejar vacío en producción)
META_CAPI_TEST_EVENT_CODE=

# ID del Dataset de Meta para Conversions API
META_DATASET_ID=

# ID de la aplicación en Meta Developers
META_APP_ID=

# Alias legacy de META_APP_ID
APP_ID=

# Secreto de la app de Facebook, usado para validar el webhook de Messenger
FB_APP_SECRET=

# Secreto general de la app de Meta (fallback si no hay secreto específico por canal)
APP_SECRET=

# Flag de emergencia: purga y vuelve a sembrar el catálogo al arrancar. Dejar en false salvo que lo pidas explícitamente
FORCE_CLEAN_SEED=false

# Marca cargada desde config/brand/{BRAND_NAME}/. Requiere reiniciar el servicio para aplicar cambios. VentiMax usa BRAND_NAME=ventimax
BRAND_NAME=default

# Entorno. En Render debe ser production (cookies Secure y comprobación de JWT_SECRET).
NODE_ENV=

# Cloudinary: almacenamiento de comprobantes e imágenes (cloudinary.com → Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI: generación de imágenes en AI Studio (opcional)
OPENAI_API_KEY=
